<?xml version="1.0" encoding="UTF-8"?>
<!-- Boost Garmin watch face — Venu 3 first target (454x454 AMOLED round).
     App id generated 2026-07-08; keep stable across releases. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="BoostGarminApp"
        id="c87388c1f2c74b3baec0ed1d11af74de"
        launcherIcon="@Drawables.LauncherIcon"
        name="@Strings.AppName"
        type="watchface"
        minApiLevel="3.2.0">
        <iq:products>
            <!-- Phase 0: Venu 3 only. Add venu3s / epix2 / fr965 etc. once it runs. -->
            <iq:product id="venu3"/>
            <iq:product id="vivoactive5"/>
        </iq:products>
        <iq:permissions>
            <!-- makeWebRequest to the AAPS phone HTTP server (bridged via Garmin Connect Mobile). -->
            <iq:uses-permission id="Communications"/>
            <!-- 5-min background ServiceDelegate that does the pull. -->
            <iq:uses-permission id="Background"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
